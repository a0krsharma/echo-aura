rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ───────────────────────────────────────────────────────────
    // Anyone can read a public profile.
    // Only the owner can write their own document.
    match /users/{userId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if false; // never delete user docs
    }

    // ── POSTS ───────────────────────────────────────────────────────────
    // Public read access (The Frequency is open).
    // Only authenticated users can create posts.
    // authorUid in the document MUST match the actual Firebase UID.
    match /posts/{postId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.audioUrl is string;
      allow update: if request.auth != null; // pulse / reverb count increments
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;

      // Reverbs sub-collection (voice comments)
      match /reverbs/{reverbId} {
        allow read:   if true;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ── ECHOES ──────────────────────────────────────────────────────────
    match /echoes/{echoId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;

      // Reverbs sub-collection
      match /reverbs/{reverbId} {
        allow read:   if true;
        allow create: if request.auth != null;
      }
    }

    // ── CLASHES / THE STAGE ─────────────────────────────────────────────
    // Public read for live debates.
    // Authenticated users can create debates and vote.
    match /clashes/{clashId} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // votes, listener count
      allow delete: if false;

      // Vibe Chat messages sub-collection
      match /messages/{messageId} {
        allow read:   if true;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── NOTIFICATIONS ────────────────────────────────────────────────────
    // lib/notifications.ts writes to notifications/{uid}/items/{notifId} subcollection
    match /notifications/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /items/{notifId} {
        allow read:   if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null; // any auth user can notify another
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── NOTIFICATIONS (legacy flat collection — keep for backward compat) ──
    match /notifications_flat/{notifId} {
      allow read:   if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
    }

    // ── WHISPERS (Private DMs) ─────────────────────────────────────────
    // Only participants can read/write their own conversations
    match /whispers/{conversationId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Whisper messages sub-collection
      match /messages/{messageId} {
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/whispers/$(conversationId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/whispers/$(conversationId)).data.participants;
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/whispers/$(conversationId)).data.participants;
        allow delete: if false;
      }

      // Signaling sub-collection for WebRTC (offer/answer/ice)
      match /signaling/{sigId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/whispers/$(conversationId)).data.participants;
      }
    }

    // ── WIRE (alias for whispers during migration)
    // Mirror rules so new clients can write to /wire while backend still uses /whispers
    match /wire/{conversationId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/wire/$(conversationId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/wire/$(conversationId)).data.participants;
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/wire/$(conversationId)).data.participants;
        allow delete: if false;
      }

      match /signaling/{sigId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/wire/$(conversationId)).data.participants;
      }
    }

    // ── ROOMS ────────────────────────────────────────────────────────────
    // Public read for room discovery
    // Authenticated users can create rooms
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // ── ROOM PARTICIPANTS ───────────────────────────────────────────────
    // Room participants sub-collection
    match /room_participants/{participantId} {
      allow read, write: if true;
    }

    // ── ROOM MESSAGES ─────────────────────────────────────────────────
    // Room chat messages
    match /room_messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── ROOM REACTIONS ────────────────────────────────────────────────
    // Room emoji reactions
    match /room_reactions/{reactionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── USER BOOKMARKS ────────────────────────────────────────────────
    // User room bookmarks
    match /user_bookmarks/{bookmarkId} {
      allow read: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── FOLLOWS ──────────────────────────────────────────────────────
    // User follow relationships
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── CLASH QUESTIONS ──────────────────────────────────────────────
    // Q&A questions for debates
    match /clash_questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── OPEN USERS ────────────────────────────────────────────────────
    // Users who are open for talk on Radar
    match /openUsers/{userId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ── POST COMMENTS ─────────────────────────────────────────────
    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // likes/unlike increment
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // ── BREAKOUT ROOMS ────────────────────────────────────────────
    match /breakout_rooms/{breakoutId} {
      allow read, write: if request.auth != null;
    }

  }
}
