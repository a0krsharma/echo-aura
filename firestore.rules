rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ───────────────────────────────────────────────────────────
    // Anyone can read a public profile.
    // Only the owner can write their own document.
    match /users/{userId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null;
      allow delete: if false; // never delete user docs
    }

    // ── POSTS ───────────────────────────────────────────────────────────
    // Public read access (The Frequency is open).
    // Only authenticated users can create posts.
    // authorUid in the document MUST match the actual Firebase UID.
    match /posts/{postId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.audioUrl is string;
      allow update: if request.auth != null; // pulse / reverb count increments
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;

      // Reverbs sub-collection (voice comments)
      match /reverbs/{reverbId} {
        allow read:   if true;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ── ECHOES ──────────────────────────────────────────────────────────
    match /echoes/{echoId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;

      // Reverbs sub-collection
      match /reverbs/{reverbId} {
        allow read:   if true;
        allow create: if request.auth != null;
      }
    }

    // ── CLASHES / THE STAGE ─────────────────────────────────────────────
    // Public read for live debates.
    // Stage members can view, vote, join audience, and chat seamlessly.
    match /clashes/{clashId} {
      allow read, write: if true;

      // Live Audience profiles & reactions sub-collection
      match /audience/{uid} {
        allow read, write, delete: if true;
      }

      // Per-user Vote / Allegiance records (Strict single vote per user)
      match /votes/{uid} {
        allow read, write, delete: if true;
      }

      // Vibe Chat messages sub-collection
      match /messages/{messageId} {
        allow read, write: if true;
        allow delete: if false;
      }

      // Q&A questions sub-collection
      match /questions/{questionId} {
        allow read, write: if true;
        allow delete: if false;
      }
    }

    // ── NOTIFICATIONS ────────────────────────────────────────────────────
    // lib/notifications.ts writes to notifications/{uid}/items/{notifId} subcollection
    match /notifications/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /items/{notifId} {
        allow read:   if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null; // any auth user can notify another
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── NOTIFICATIONS (legacy flat collection — keep for backward compat) ──
    match /notifications_flat/{notifId} {
      allow read:   if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
    }

    // ── WHISPERS (Private DMs) ─────────────────────────────────────────
    match /whispers/{conversationId} {
      allow read, create, update, delete: if true;

      // Whisper messages sub-collection
      match /messages/{messageId} {
        allow read, create, update, delete: if true;
      }

      // Signaling sub-collection for WebRTC (offer/answer/ice)
      match /signaling/{sigId} {
        allow read, write: if true;
      }
    }

    // ── WIRE (alias for whispers during migration) ─────────────────────
    match /wire/{conversationId} {
      allow read, create, update, delete: if true;

      match /messages/{messageId} {
        allow read, create, update, delete: if true;
      }

      match /signaling/{sigId} {
        allow read, write: if true;
      }
    }

    // ── ROOMS & ARCADE ARENAS ────────────────────────────────────────────
    // Public read for room & arcade discovery, full real-time state sync
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // ── ARCADE GAME MATCHES ─────────────────────────────────────────────
    // Isolated from audio rooms — game sessions only
    match /arcade_matches/{matchId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // ── ROOM PARTICIPANTS ───────────────────────────────────────────────
    // Room participants sub-collection
    match /room_participants/{participantId} {
      allow read, write: if true;
    }

    // ── ROOM MESSAGES ─────────────────────────────────────────────────
    // Room chat messages
    match /room_messages/{messageId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if false;
    }

    // ── ROOM REACTIONS ────────────────────────────────────────────────
    // Room emoji reactions
    match /room_reactions/{reactionId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if false;
    }

    // ── FREQUENCY+ EPISODES & SERIES ──────────────────────────────────
    match /frequency_plus_episodes/{episodeId} {
      allow read, write: if true;
      match /voice_replies/{replyId} {
        allow read, write: if true;
      }
    }

    // ── USER BOOKMARKS ────────────────────────────────────────────────
    // User room bookmarks
    match /user_bookmarks/{bookmarkId} {
      allow read: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // ── FOLLOWS ──────────────────────────────────────────────────────
    // User follow relationships
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── CLASH QUESTIONS ──────────────────────────────────────────────
    // Q&A questions for debates
    match /clash_questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── OPEN USERS ────────────────────────────────────────────────────
    // Users who are open for talk on Radar
    match /openUsers/{userId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ── POST COMMENTS ─────────────────────────────────────────────
    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // likes/unlike increment
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // ── BREAKOUT ROOMS ────────────────────────────────────────────
    match /breakout_rooms/{breakoutId} {
      allow read, write: if request.auth != null;
    }

    // ── USER VAULT (Saved Posts) ──────────────────────────────────
    match /user_vault/{vaultId} {
      allow read, write: if request.auth != null;
    }

    // ── REPORTS (Moderation) ──────────────────────────────────────
    match /reports/{reportId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── RADAR & TRENDING FEEDS ─────────────────────────────────────
    match /radar_feeds/{feedId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /radar_feeds/{feedId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── HASHTAGS & DISCOVERY ───────────────────────────────────────
    match /hashtags/{tag} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hashtag_posts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /user_hashtag_following/{id} {
      allow read, write: if request.auth != null;
    }

    match /trending_topics/{topicId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── ARCADE MATCHES & TOURNAMENTS (Multiplayer Gaming Lounge) ──
    match /arcade_matches/{matchId} {
      allow read, write, delete: if true;
    }

    match /arcade_tournaments/{tournamentId} {
      allow read, write, delete: if true;
    }

  }
}
