# ─────────────────────────────────────────────
# ECHO — .gitignore (Production-hardened)
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──────────────────────
/.next/
/out/
/build

# ── Environment — NEVER COMMIT ───────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Firebase credentials ──────────────────────
*-firebase-adminsdk*.json
serviceAccountKey.json
.firebase/

# ── Vercel ────────────────────────────────────
.vercel

# ── Capacitor / Android native ───────────────
/android/.gradle/
/android/app/build/
/android/build/
/android/.idea/
*.apk
*.aab

# ── macOS ─────────────────────────────────────
.DS_Store
*.pem

# ── Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript cache ──────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────
/coverage

.vercel
